# Copy to secrets.properties (not committed) and fill in: the same values as the site's
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY. drivexUrl is optional (default https://app.drivex.ae).
supabaseUrl=https://YOUR-PROJECT.supabase.co
supabaseAnonKey=YOUR-ANON-KEY
# Optional, for push notifications: the Android app's values in the Firebase console (Project settings > Your apps > com.drivex.app).
fcmAppId=
fcmApiKey=
fcmProjectId=
fcmSenderId=
